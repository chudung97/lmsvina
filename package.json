{
  "name": "pdf-seal-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run api:dev\" \"vite\"",
    "api:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\run-laravel.ps1 -Mode dev",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\run-laravel.ps1 -Mode local",
    "start:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\run-laravel.ps1 -Mode lan",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview",
    "attendance:replace": "node scripts/zkteco-attendance-collector.cjs --replace-history",
    "db:migrate:sqlite": "node scripts/migrate-sqlite-to-mysql.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^18.0.9",
    "laravel-echo": "^2.6.1",
    "mysql2": "^3.24.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zklib-js": "^1.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "express": "^5.3.0",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
